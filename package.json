{
  "name": "network-plus-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "refresh:curriculum": "node scripts/generate-refreshed-app.mjs && node scripts/inject-chat-context.mjs",
    "test:curriculum": "node scripts/test-curriculum-refresh.mjs",
    "test:chat": "node scripts/test-chat-state.mjs && node scripts/test-chat-relay.mjs",
    "lint:chat": "eslint src/chat functions/api/chat.js",
    "verify:chatbot": "npm run test:chat && npm run test:curriculum && npm run lint:chat && npm run build",
    "predev": "npm run refresh:curriculum && npm run test:curriculum",
    "dev": "vite --host 127.0.0.1 --port 7777",
    "prestart": "npm run refresh:curriculum && npm run test:curriculum",
    "start": "vite --host 127.0.0.1 --port 7777 --open",
    "prebuild": "npm run refresh:curriculum && npm run test:curriculum",
    "build": "vite build",
    "lint": "eslint .",
    "audit:doctrine": "node scripts/audit-network-plus-doctrine.mjs",
    "audit:doctrine:strict": "node scripts/audit-network-plus-doctrine.mjs --strict",
    "preview": "vite preview --host 127.0.0.1 --port 7777",
    "serve": "npx serve -s dist -l 7777"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.4"
  }
}
